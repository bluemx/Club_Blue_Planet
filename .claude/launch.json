{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "home",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5180",
        "--directory",
        "home"
      ],
      "port": 5180
    },
    {
      "name": "api",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd api && npx wrangler dev --port 8787"
      ],
      "port": 8787
    },
    {
      "name": "app",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd app && BROWSER=none npx quasar dev --port 9200"
      ],
      "port": 9200
    }
  ]
}