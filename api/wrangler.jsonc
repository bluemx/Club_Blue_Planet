{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clubblueplanet",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "749fddd2fc3c14d436d163395cfaa923",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "club-blue-planet",
      "database_id": "d1516d1b-07de-4a22-8dbd-b39b6cc41333",
      "migrations_dir": "migrations"
    }
  ],
  // Photo evidence. Never served straight from R2 — the Worker checks the
  // session first, so a family's photos are not guessable public URLs.
  "r2_buckets": [
    { "binding": "EVIDENCE", "bucket_name": "club-blue-planet-evidencias" }
  ],
  // Cloudflare Email Sending. Delivery to non-verified recipients requires
  // the sending domain to be onboarded in the dashboard first.
  // Workers AI: mission ideas for a child's age and a parent's topic.
  "ai": { "binding": "AI" },
  // 11:00 UTC = 05:00 in Mexico: today's recurring missions.
  // Monday 15:00 UTC = 09:00: the weekly report email.
  "triggers": { "crons": ["0 11 * * *", "0 15 * * 1"] },
  "send_email": [
    { "name": "EMAIL" }
  ],
  "vars": {
    // Origins allowed to call this API with credentials.
    "APP_ORIGINS": "https://clubblueplanet-app.ealbinu.workers.dev",
    "MAIL_FROM": "no-reply@unmensaje.com",
    "BETTER_AUTH_URL": "https://clubblueplanet.ealbinu.workers.dev"
  }
  // Secrets (set with `wrangler secret put`): BETTER_AUTH_SECRET
}
